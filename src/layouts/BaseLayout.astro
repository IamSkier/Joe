---
import '../styles/global.css';
import '../../css/styles.css';
import { SITE } from '../consts';
import { sitePath } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  home?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  type = 'website',
  home = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, new URL(sitePath(''), Astro.site));
const socialImage = image ? new URL(sitePath(image), Astro.site) : new URL(sitePath('images/sipme.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} writing`} href={sitePath('rss.xml')} />
    <link rel="icon" href={sitePath('images/sipme.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={home ? 'homepage' : undefined}>
    <header class:list={['site-header', home && 'site-header-home']}>
      <a class="site-brand" href={sitePath('')} aria-label={`${SITE.name} home`}>JDN<span>.</span></a>
      <nav aria-label="Main navigation">
        {home ? <>
          <a href={`${sitePath('')}#my-work`}>Work</a>
          <a href={`${sitePath('')}#blog`}>Writing</a>
        </> : <>
          <a href={sitePath('work/')}>Work</a>
          <a href={sitePath('blog/')}>Writing</a>
        </>}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <div>
        {SITE.linkedin && <a href={SITE.linkedin}>LinkedIn</a>}
        <a href={sitePath('rss.xml')}>RSS</a>
      </div>
    </footer>
  </body>
</html>