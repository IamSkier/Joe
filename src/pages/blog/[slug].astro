---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | John`} description={post.data.summary} image={post.data.cover} type="article">
  <article class="article">
    <a href={sitePath('blog/')}>← All writing</a>
    <p class="entry-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', { dateStyle: 'long' })}</time></p>
    <h1>{post.data.title}</h1>
    <p class="content-copy">{post.data.summary}</p>
    {post.data.cover && <img class="article-cover" src={sitePath(post.data.cover)} alt={post.data.title} />}
    <div class="article-content"><Content /></div>
    {post.data.tags.length > 0 && <ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
  </article>
</BaseLayout>