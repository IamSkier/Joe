---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing | John">
  <section class="page-shell">
    <header class="page-intro"><h1>Writing</h1><p>Notes, lessons, and ideas from the work.</p></header>
    {posts.length ? <div class="entry-grid">
      {posts.map((post) => <article class="entry-card">
        {post.data.cover && <img src={sitePath(post.data.cover)} alt={post.data.title} loading="lazy" />}
        <div class="entry-card-body"><p class="entry-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', { dateStyle: 'long' })}</time></p><h2><a href={sitePath(`blog/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.summary}</p></div>
      </article>)}
    </div> : <p class="empty-state">No articles published yet.</p>}
  </section>
</BaseLayout>