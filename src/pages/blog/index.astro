---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing | John">
  <section class="page-shell">
    <header class="page-intro"><p class="eyebrow">NOTES</p><h1>Writing</h1></header>
    {posts.length ? <div class="writing-list">
      {posts.map((post) => <a class="writing-row" href={sitePath(`blog/${post.id}/`)}>
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short' })}</time>
        <span><strong>{post.data.title}</strong><span>{post.data.summary}</span></span>
        <span class="project-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div> : <p class="empty-state">No articles published yet.</p>}
  </section>
</BaseLayout>