---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/site';

const [allPosts, allProjects] = await Promise.all([
  getCollection('posts'),
  getCollection('projects')
]);
const posts = allPosts.filter(({ data }) => !data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const projects = allProjects.filter(({ data }) => !data.draft && data.featured).slice(0, 3);
---

<BaseLayout home>
  <header id="header" class="header home-hero">
    <div class="hero-panel">
      <div class="hero-copy">
        <p class="eyebrow">Designer · Builder · Analyst</p>
        <h1>I turn ideas into thoughtful digital work.</h1>

        <div class="hero-actions">
          <a class="hero-link primary" href={sitePath('#my-work')}>View work <span aria-hidden="true">↘</span></a>
          <a class="hero-link secondary" href={sitePath('#blog')}>Read Notes</a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Portrait illustration">
        <div class="portrait-card">
          <div class="portrait-glow"></div>
          <img class="hero-art" src={sitePath('images/sipme.png')} alt="Sipme brand image" fetchpriority="high" />
        </div>
      </div>
    </div>
  </header>

  <section id="my-work" class="home-section work-section">
    <div class="section-inner">
      <header class="section-heading"><p class="eyebrow">01 / SELECTED WORK</p><h2>Work</h2></header>
      {projects.length ? <div class="project-list">
        {projects.map((project, index) => <a class="project-row" href={sitePath(`work/${project.id}/`)}>
          <span class="project-number">0{index + 1}</span>
          <span class="project-copy"><strong>{project.data.title}</strong><span>{project.data.summary}</span></span>
          <span class="project-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div> : <p class="empty-line">No projects published yet.</p>}
    </div>
  </section>

  <section id="blog" class="home-section writing-section">
    <div class="section-inner">
      <header class="section-heading"><p class="eyebrow">02 / NOTES</p><h2>Writing</h2></header>
      {posts.length ? <div class="writing-list">
        {posts.map((post) => <a class="writing-row" href={sitePath(`blog/${post.id}/`)}>
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short' })}</time>
          <span><strong>{post.data.title}</strong><span>{post.data.summary}</span></span>
          <span class="project-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div> : <p class="empty-line">No writing yet.</p>}
      <a class="section-link" href={sitePath('blog/')}>All writing <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
