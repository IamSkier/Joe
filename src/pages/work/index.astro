---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<BaseLayout title="Work | John">
  <section class="page-shell">
    <header class="page-intro"><p class="eyebrow">SELECTED PROJECTS</p><h1>Work</h1></header>
    {projects.length ? <div class="project-list">
      {projects.map((project, index) => <a class="project-row" href={sitePath(`work/${project.id}/`)}>
        <span class="project-number">0{index + 1}</span>
        <span class="project-copy"><strong>{project.data.title}</strong><span>{project.data.summary}</span></span>
        <span class="project-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div> : <p class="empty-state">No projects published yet.</p>}
  </section>
</BaseLayout>