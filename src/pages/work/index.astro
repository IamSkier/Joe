---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<BaseLayout title="Work | John">
  <section class="page-shell">
    <header class="page-intro"><h1>Work</h1><p>Selected projects, experiments, and things I’ve made.</p></header>
    {projects.length ? <div class="entry-grid">
      {projects.map((project) => <article class="entry-card">
        {project.data.cover && <img src={sitePath(project.data.cover)} alt={project.data.title} loading="lazy" />}
        <div class="entry-card-body"><h2><a href={sitePath(`work/${project.id}/`)}>{project.data.title}</a></h2><p>{project.data.summary}</p>{project.data.technologies.length > 0 && <ul class="tag-list">{project.data.technologies.map((technology) => <li>{technology}</li>)}</ul>}</div>
      </article>)}
    </div> : <p class="empty-state">No projects published yet.</p>}
  </section>
</BaseLayout>